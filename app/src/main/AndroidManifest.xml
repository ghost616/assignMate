<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 相机：作业拍照 OCR 识别 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 录音：语音输入/识别 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 网络：在线能力预留（OCR 云端识别 / 数据同步） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 通知：作业提醒与计时完成通知（Android 13+ 需运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 精确闹钟：作业/休息提醒（Android 12+ 由用户在系统闹钟页授予） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 前台服务：专注计时走秒 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 前台服务类型权限（Android 14 / API 34 起：声明 foregroundServiceType 必须同时申请对应类型权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 唤醒锁：计时期间保持通知走秒（不申请忽略电池优化） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 震动：作业到点提醒（无通知权限时仍以震动提示） -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 相机非必需：无相机设备也可安装（OCR 非唯一录入方式） -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".AssignMateApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AssignMate">

        <!-- 单 Activity 宿主：加载 Compose 导航宿主 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AssignMate">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider：作业拍照录入把缓存目录下的临时图片以 content:// 交给系统相机写入 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 计时走秒前台服务：退到后台/锁屏时计时持续，常驻通知展示当前作业与已用时。
             specialUse 类型对应「用户主动发起的专注计时」这类无对口系统类型的场景，
             需配合 FOREGROUND_SERVICE_SPECIAL_USE 权限与 subtype 属性（Android 14 起强制要求） -->
        <service
            android:name=".timer.service.TimerTickerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="作业专注计时走秒：用户主动开始计时后保持计时与状态通知" />
        </service>

        <!-- 作业到点提醒广播接收器：仅由应用内的 AlarmManager 闹钟显式触发，
             exported=false 保证外部应用无法伪造提醒广播 -->
        <receiver
            android:name=".timer.service.HomeworkAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>